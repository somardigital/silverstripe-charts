{
    "name": "flashbackzoo/silverstripe-charts",
    "type": "silverstripe-vendormodule",
    "description": "Display your data using Chart.js",
    "license": "MIT",
    "keywords": ["SilverStripe", "Chart.js", "Graph"],
    "authors": [
        {
            "name": "David Craig",
            "email": "david@davidcraig.co.nz"
        },
        {
            "name": "Ian Herbert",
            "email": "ian@silverstripe.com"
        },
        {
            "name": "Jared Lee",
            "email": "jared@silverstripe.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "undefinedoffset/sortablegridfield": "^3",
        "tractorcow/silverstripe-colorpicker": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },    
	"extra": {
		"expose": [
			"static/js/dist"
		]
	}
}
